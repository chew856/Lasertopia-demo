DATABASE_URL="file:./dev.db"

# ── Manager backend sign-in (/manage/*) ────────────────────────────────────────────────
#
# FAIL CLOSED. If any of the three below is unset or malformed, /manage/login says so and
# every staff screen redirects to it. There is no default account and no fallback: an
# unconfigured server serves no staff screens at all.
#
# No password is ever stored here or anywhere in the repo. MANAGER_PASSWORD_HASH holds a
# scrypt hash; the plaintext exists only in whoever's head or password manager.

# Signs the staff session cookie (HMAC-SHA256). At least 32 characters. Rotating it signs
# everyone out, which is the intended way to end every session at once.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MANAGER_SESSION_SECRET=""

# The bootstrap staff account. On first successful sign-in a matching ManagerUser row is
# created so every audit entry has a real actor to name. Further staff accounts can then be
# added as ManagerUser rows with a hash in the same format.
MANAGER_EMAIL=""

# scrypt hash of the staff password, as `scrypt$N$r$p$saltHex$keyHex`. Generate one with:
#   node -e "const c=require('node:crypto');const s=c.randomBytes(16);const p=process.argv[1];\
#   console.log(['scrypt',16384,8,1,s.toString('hex'),c.scryptSync(p.normalize('NFKC'),s,64,\
#   {N:16384,r:8,p:1,maxmem:134217728}).toString('hex')].join('$'))" 'your-password-here'
#
# IMPORTANT — escape every `$` in the hash as `\$` when you paste it in here. Next.js runs
# .env values through dotenv-expand, which reads `$16384` as an undefined variable and
# silently blanks it. Unescaped, the hash loads mangled and /manage/login reports it as
# malformed while the file on disk looks perfectly correct. So:
#   MANAGER_PASSWORD_HASH="scrypt\$16384\$8\$1\$<saltHex>\$<keyHex>"
MANAGER_PASSWORD_HASH=""

# Optional. The display name used in `{staffName}` on the board, the booking log and the
# activity feed. Defaults to the part of MANAGER_EMAIL before the @.
MANAGER_NAME=""
